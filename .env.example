# Copy to .env in the directory from which you launch cobalt.
# Default: fill only DEEPSEEK_API_KEY. Never commit a real key.
# Selection: provider + its key; optionally choose pro or an exact model ID.
COBALT_PROVIDER=deepseek
COBALT_MODEL_TIER=fast
# COBALT_MODEL_ID=
# COBALT_BASE_URL=  # HTTPS override for regional or private gateways

# Only the selected provider's key is required.
DEEPSEEK_API_KEY=
ZAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
MINIMAX_API_KEY=

# Provider presets, fast / pro (exact IDs and endpoints live in model_config.py):
# deepseek:    deepseek-flash / deepseek-v4-pro
# zai:         glm-5.3-flash / glm-5.3
# qwen:        qwen3.8-flash / qwen3.8-max (Beijing region key)
# kimi:        kimi-k2.6 / kimi-k3
# openai:      gpt-6-luna / gpt-6-sol (Chat tool calls use reasoning_effort=none)
# gemini:      gemini-3.8-flash / gemini-3.1-pro-preview
# anthropic:   claude-haiku-4-5 / claude-sonnet-5 (native Messages API)
# groq:        llama-3.1-8b-instant / llama-3.3-70b-versatile
# mistral:     mistral-small-latest / mistral-medium-latest
# xai:         grok-4.7 / grok-4.7
# openrouter:  openai/gpt-oss-120b / openai/gpt-oss-120b
# siliconflow: deepseek-ai/DeepSeek-V4-Flash / Pro/deepseek-ai/DeepSeek-V4
# minimax:     MiniMax-M2.7 / MiniMax-M3
